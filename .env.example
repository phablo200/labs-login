# Auth service base URL. Local auth-service usually runs on port 3001.
VITE_AUTH_API_BASE_URL=http://localhost:3001/api

# Browser-exposed application identifier headers required by auth-service.
# These are not secrets in a Vite frontend; replace with values issued for your app.
VITE_AUTH_API_KEY=replace-with-local-api-key
VITE_AUTH_APPLICATION_ID=replace-with-application-id
